# TrustVault Environment Configuration

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Session Secrets
# Generate a strong 32+ character key for production (e.g. openssl rand -hex 32)
SECRET_KEY=trustvault-super-secure-jwt-secret-key-change-in-production-2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# PostgreSQL: postgresql+psycopg://username:password@localhost:5432/trustvault
# SQLite (for local testing/dev): sqlite:///./trustvault.db
DATABASE_URL=sqlite:///./trustvault.db

# Private Storage Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./private_storage
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 Megabytes

# Audit Trail Security
# Checkpoint HMAC key used for signing periodic audit-chain checkpoints
AUDIT_CHECKPOINT_KEY=trustvault-audit-hmac-checkpoint-secret-key-32chars!!

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120

# Optional S3 Storage Configuration (when STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=trustvault-private-documents
# S3_REGION=us-east-1
